# Public (exposed to the browser)
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Server only (Netlify Functions / CI)
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One-time $5 price for a single course
STRIPE_PRICE_COURSE=
# Recurring $24/year price for the All-Access Pass
STRIPE_PRICE_PASS=
# Optional: $5-off-once coupon applied when a single-course buyer upgrades to the pass
STRIPE_COUPON_UPGRADE=
# "true" once Stripe Tax is configured
STRIPE_AUTOMATIC_TAX=false
