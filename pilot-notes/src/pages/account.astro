---
import Site from "../layouts/Site.astro";
import AccountPanel from "../components/account/AccountPanel.tsx";
import { courses } from "../content/catalog.ts";
const labels = courses.map(({ slug, title }) => ({ slug, title }));
---
<Site title="Account & billing" noindex>
  <section class="wrap page">
    <h1 class="page__title">Account & billing</h1>
    <AccountPanel client:only="react" courses={labels} />
  </section>
</Site>
