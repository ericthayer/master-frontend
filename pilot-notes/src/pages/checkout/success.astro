---
import Site from "../../layouts/Site.astro";
import CheckoutSuccessGate from "../../components/account/CheckoutSuccessPage.tsx";
import { courses } from "../../content/catalog.ts";
const firstModules = Object.fromEntries(courses.map((c) => [c.slug, c.modules[0]!.id]));
---
<Site title="Thanks for your purchase" noindex>
  <section class="wrap page">
    <h1 class="page__title">Thank you!</h1>
    <CheckoutSuccessGate client:only="react" firstModules={firstModules} />
  </section>
</Site>
