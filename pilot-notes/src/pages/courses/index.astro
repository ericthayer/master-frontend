---
import Site from "../../layouts/Site.astro";
import CourseCard from "../../components/site/CourseCard.astro";
import { outlines } from "../../content/catalog.ts";
---
<Site title="Courses" description="Every Pilot Notes course: short, game-like and ending with a live project.">
  <section class="wrap page">
    <h1 class="page__title">Course library</h1>
    <p class="page__lede">Each course takes under an hour and ends with something live on the internet.</p>
    <div class="cgrid">{outlines.map((c) => <CourseCard course={c} />)}</div>
  </section>
</Site>
