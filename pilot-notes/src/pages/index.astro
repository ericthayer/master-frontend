---
import Site from "../layouts/Site.astro";
import Hero from "../components/marketing/Hero.astro";
import HowItWorks from "../components/marketing/HowItWorks.astro";
import AudienceTracks from "../components/marketing/AudienceTracks.astro";
import CourseLibrary from "../components/marketing/CourseLibrary.astro";
import PlayerPreview from "../components/marketing/PlayerPreview.astro";
import FreeCourseCTA from "../components/marketing/FreeCourseCTA.astro";
import Pricing from "../components/site/Pricing.astro";
import Testimonials from "../components/marketing/Testimonials.astro";
import Faq from "../components/marketing/Faq.astro";
import { product } from "../config/product.ts";
import "../styles/marketing.css";
---
<Site title={`${product.name} — ${product.tagline}`} description="Fast, game-like GitHub Copilot courses that end with a live project. Free beginner course; $5 per course or $24/year for everything.">
  <Hero />
  <HowItWorks />
  <AudienceTracks />
  <CourseLibrary />
  <PlayerPreview />
  <FreeCourseCTA />
  <section id="pricing" class="sec wrap" aria-labelledby="price-h">
    <p class="sec__kicker">Pricing</p>
    <h2 id="price-h" class="sec__title">Less than a coffee per course.</h2>
    <Pricing />
  </section>
  <Testimonials />
  <Faq />
</Site>
